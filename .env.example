# Live Together needs Supabase Realtime. Photo Letters and solo booth work without it.
# Copy to .env.local; do not commit your .env.local file.
# These two values come from Supabase > Connect.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# NEVER add service_role, secret, database passwords, or TURN credentials here.
